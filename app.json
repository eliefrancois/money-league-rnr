{
  "expo": {
    "name": "PotKeeper",
    "slug": "money-league",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/potkeeper-icon.png",
    "scheme": "potkeeper",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/potkeeper-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "dark": {
        "image": "./assets/images/potkeeper-mark.png",
        "backgroundColor": "#0A0A0F"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eliefrancois.moneyleague"
    },
    "android": {
      "package": "com.eliefrancois.moneyleague",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/potkeeper-mark.png",
        "backgroundColor": "#22C55E"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/potkeeper-mark.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://www.elief.dev"
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7910e433-fe20-4995-8a11-4b67be96dd5d"
      }
    },
    "owner": "eliefrancois",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/7910e433-fe20-4995-8a11-4b67be96dd5d"
    }
  }
}
